generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  createdAt     DateTime  @default(now())
  
  rankings      Ranking[]
  watchlist     Watchlist[]
  following     Follow[]  @relation("UserFollowing")
  followers     Follow[]  @relation("UserFollowers")
  activities    Activity[]
}

model Title {
  id            String    @id @default(cuid())
  tmdbId        Int?      @unique
  title         String
  posterUrl     String?
  year          Int?
  type          String    // "movie" or "tv"
  genres        String?   // JSON array stored as string
  createdAt     DateTime  @default(now())
  
  rankings      Ranking[]
  watchlist     Watchlist[]
  activities    Activity[]
  
  @@index([type])
}

model Ranking {
  id            String    @id @default(cuid())
  userId        String
  titleId       String
  bucket        String    // "liked", "fine", "disliked"
  rank          Int       // position within bucket (0-indexed)
  score         Float     // derived score (0-10)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         Title     @relation(fields: [titleId], references: [id], onDelete: Cascade)
  
  @@unique([userId, titleId])
  @@index([userId, bucket, rank])
}

model Watchlist {
  id            String    @id @default(cuid())
  userId        String
  titleId       String
  createdAt     DateTime  @default(now())
  
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         Title     @relation(fields: [titleId], references: [id], onDelete: Cascade)
  
  @@unique([userId, titleId])
  @@index([userId])
}

model Follow {
  id            String    @id @default(cuid())
  followerId    String
  followingId   String
  createdAt     DateTime  @default(now())
  
  follower      User      @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following     User      @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)
  
  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Activity {
  id            String    @id @default(cuid())
  userId        String
  titleId       String
  type          String    // "ranked"
  bucket        String?   // for ranked activities
  score         Float?    // for ranked activities
  createdAt     DateTime  @default(now())
  
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         Title     @relation(fields: [titleId], references: [id], onDelete: Cascade)
  
  @@index([userId, createdAt])
  @@index([createdAt])
}
